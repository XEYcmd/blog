---
import Doc from '../../../components/Doc.astro';
import { postPage } from '../../../lib/post';
import { loadPosts } from '../../../lib/data';

export function getStaticPaths() {
  return loadPosts().map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const html = postPage({ lang: 'en', path: `/en/posts/${post.id}/`, post, all: loadPosts() });
---

<Doc html={html} />
